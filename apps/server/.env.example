JWT_SECRET=replace-with-a-random-secret
ADMIN_EMAILS=admin@example.com
DATABASE_PATH=./data/gen-mod.sqlite
HOST=127.0.0.1
PORT=8787

QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 使用与存储空间区域匹配的上传、资源管理地址。
QINIU_UPLOAD_URL=https://upload.qiniup.com
QINIU_RESOURCE_URL=https://rs.qiniu.com
# 七牛私有空间的 HTTPS 下载域名，不带文件路径。
QINIU_DOWNLOAD_URL=

# 前后端同源时无需设置；跨域部署时填写管理端来源。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# HTTPS 反向代理部署时设置为 true。
COOKIE_SECURE=false
